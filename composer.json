{
    "name": "cdkbjn/sibadak",
    "description": "SIBADAK — Sistem Informasi Basis Data Kehutanan (CDK Wilayah Bojonegoro)",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "phpoffice/phpspreadsheet": "^2.3",
        "tecnickcom/tcpdf": "^6.7"
    },
    "autoload": {
        "classmap": [
            "models/",
            "controllers/"
        ],
        "files": [
            "helpers/functions.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.10"
        }
    }
}
